# Local environments, credentials and machine state
.DS_Store
.venv*/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.pem
*.key
.aris/

# Respondent-level inputs, outputs, caches and model weights stay local
/data/
/tmp/
/output/
**/data/
**/checkpoints/
**/models/
**/logs/
*.log
*.jsonl
*.pkl
*.pickle
*.parquet
*.joblib
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.npy
*.npz

# Share reviewed aggregate results, not row-level predictions or live runs
/results/*
!/results/*.csv
!/results/baseline_design.json
!/results/cost_summary.json
!/results/final_validation.json
!/results/integrity_checks.json
!/results/environment_main.txt
!/results/environment_qwen.txt
/experiments/**/results/
/experiments/**/model_manifest.json
/experiments/**/environment_versions.json
/experiments/**/eurostat-catalogue.txt

# Keep third-party PDFs, handoff material and superseded report copies local
/sources/*
!/sources/ecb/
/sources/ecb/*
!/sources/ecb/download_links.json
!/sources/source_checksums.json
/reports/FINAL_REPORT_*.md
/review-stage/
/idea-stage/
/refine-logs/
